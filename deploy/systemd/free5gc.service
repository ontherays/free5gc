[Unit]
Description=free5GC core network (all NFs) - <SERVICE_USER>
Documentation=file:docs/install.md
# Deliberately NO Conflicts= and NO .target: mutual exclusion with Open5GS is enforced by
# /usr/local/bin/core-switch (flock + kernel socket checks). Open5GS is not a systemd unit.
After=network-online.target mongod.service
Wants=network-online.target free5gc-webconsole.service
Requires=mongod.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
User=root
WorkingDirectory=<INSTALL_DIR>
Environment=FREE5GC_DIR=<INSTALL_DIR>
Environment=CORE_IP=<CORE_HOST_IP>
Environment=GIN_MODE=release

ExecStartPre=/sbin/modprobe gtp5g
# Pool-scoped and idempotent (-C ... || -A). Never -F/-X/-P. iptables stores -o by NAME, so
# referencing upfgtp before the UPF creates it is valid.
ExecStartPre=/bin/sh -c '/usr/sbin/iptables -t nat -C POSTROUTING -s 10.60.0.0/16 ! -o upfgtp -j MASQUERADE 2>/dev/null || /usr/sbin/iptables -t nat -A POSTROUTING -s 10.60.0.0/16 ! -o upfgtp -j MASQUERADE'
ExecStartPre=/bin/sh -c '/usr/sbin/iptables -t mangle -C FORWARD -o upfgtp -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu 2>/dev/null || /usr/sbin/iptables -t mangle -A FORWARD -o upfgtp -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu'

# No flags: no -n3iwf, no -tngf, no -bsf, no -cp/-dp packet capture.
ExecStart=<INSTALL_DIR>/run.sh

# shared-host variant: no `killall tcpdump`, no `rm /dev/mqueue/*`, no -db.
ExecStop=<INSTALL_DIR>/force_kill-shared.sh
ExecStopPost=-/usr/bin/pkill -9 -f <INSTALL_DIR>/bin/
ExecStopPost=-/usr/sbin/iptables -t nat -D POSTROUTING -s 10.60.0.0/16 ! -o upfgtp -j MASQUERADE
ExecStopPost=-/usr/sbin/iptables -t mangle -D FORWARD -o upfgtp -p tcp --tcp-flags SYN,RST SYN -j TCPMSS --clamp-mss-to-pmtu
ExecStopPost=-/usr/sbin/ip link del upfgtp

Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=30

# No [Install] section: this unit is never enabled. core-switch starts it explicitly.
